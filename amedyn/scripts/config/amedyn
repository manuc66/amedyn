#
# Config file for Zyxel 630-11 & Asus AAM6000UG (ADSL Modem USB) 
#

# Line type
# 0x15 = ANALOG
LINE_TYPE="0x15" #  0x15 = ANALOG, 0x11 = ISDN

# Driver mode
# 1 = amedyn
DRIVER_MODE=1  # 1 = normal, 2 = debug

# Protocol
# 1 = RFC1483/2684 routed
PROTOCOL_MODE=2  # 1 = RFC1483/2684 routed, 2 = PPP over ATM (pppoa), 3 = RFC1483/2684 bridged, 4 = PPP over Ethernet (pppoe)

# xusbatm
VENDOR="0x06b9"  # 0x06b9 / 0x0b05 / 0x1767
VENDOR="0x06b9"  # 0x06b9 / 0x0b05
PRODUCT="0xa5a5" # 0xa5a5 / 0x6206
RX_ENDPOINT="0x87"
TX_ENDPOINT="0x07"
RX_ALTSETTING=1
TX_ALTSETTING=1

# Paths
BINARY_PATH="/usr/sbin"
ATM_PATH=""

# ATM
VPI=8
VCI=32

# Specific for RFC1483/2684 routed/bridged
#  if IP_ADDRESS is blank in bridged mode then it uses DHCP to get IP
IP_ADDRESS=
NETMASK=255.255.255.0
GATEWAY=

# === Re-sync modem line if line goes down
# - don't resync on line down = 0
# - resync when line goes down = 1
RESYNC=0
